<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261026140000-1" author="cpn">
        <createTable tableName="gapone_zns_log">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <!-- SEND | CALLBACK -->
            <column name="kind" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <!-- OK | ERROR | PENDING -->
            <column name="result" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="request_id" type="varchar(80)"/>
            <column name="message_id" type="varchar(80)"/>
            <column name="phone" type="varchar(32)"/>
            <column name="oa_id" type="varchar(64)"/>
            <column name="template_id" type="varchar(64)"/>
            <column name="delivery_channel" type="varchar(32)"/>
            <column name="delivery_status" type="integer"/>
            <column name="delivery_description" type="varchar(255)"/>
            <column name="error_message" type="varchar(500)"/>
            <column name="raw_json" type="varchar(4000)"/>
        </createTable>
        <createIndex tableName="gapone_zns_log" indexName="ix_gapone_zns_log_created">
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="gapone_zns_log" indexName="ix_gapone_zns_log_message">
            <column name="message_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
